{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "todd-notes",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/mcp", "/mcp/*", "/api/mcp-health"]
  },
  "vars": {
    "SUPABASE_URL": "https://ljxlhtqixlnqfqmhmper.supabase.co"
  },
  "secrets": {
    "required": ["SUPABASE_SECRET_KEY", "NOTES_MCP_TOKEN", "NOTES_OWNER_ID"]
  },
  "routes": [
    {
      "pattern": "notes.toddxburton.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
